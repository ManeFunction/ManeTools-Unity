/* Prefix/postfix chips next to the input — width follows text, like Min/Max/X/Y. */

.mie-prefix,
.mie-postfix {
    flex-grow: 0;
    flex-shrink: 0;
    width: auto;
    min-width: auto;
    max-width: none;
    overflow: visible;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.mie-prefix {
    margin-left: 0;
    margin-right: 2px;
}

.mie-postfix {
    margin-left: 2px;
    margin-right: 0;
}

/* ManeStyle puts the label gap on the input; with a prefix the gap goes before the chip instead. */
.mie-fields .unity-base-field.mie-has-prefix > .unity-base-field__input {
    margin-left: 0;
}

.mie-fields .unity-base-field.mie-has-prefix > .mie-prefix {
    margin-left: 12px;
}

.mie-fields .unity-composite-field__field.unity-base-field.mie-has-prefix > .mie-prefix {
    margin-left: 2px;
}
