/* EditorButton row under ManeStyle inspectors — flush to mie-block frame */
.mie-root > .mie-editor-buttons {
    margin-top: 5px;
    margin-bottom: 0;
}

/* Row at the end of a block or foldout (EditorButton block parameter) — aligned like a message box.
   .mie-block > also covers the row after a FoldoutBlock's content (hideWithFoldout: false). */
.mie-block > .mie-editor-buttons,
.mie-foldout-block > .unity-foldout__content > .mie-editor-buttons {
    margin-top: 3px;
    margin-right: -4px;
    margin-bottom: 0;
}

/* Row at the end of a FeatureBlock: its fields live in .mie-content, one level below the frame. */
.mie-block > .mie-content > .mie-editor-buttons {
    margin-top: 6px;
    margin-left: 2px;
    margin-right: -2px;
    margin-bottom: 0;
}

.mie-root .mie-editor-buttons > .mie-button {
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    margin-bottom: 2px;
    padding: 0 6px;
    height: 20px;
    font-size: 11px;
    align-self: stretch;
}
