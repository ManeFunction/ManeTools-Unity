<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="True">

    <Style src="ColorPicker.uss" />

    <ui:VisualElement class="picker-root">
        <ui:VisualElement class="mie-block">
            <ui:Label text="Color" class="mie-header"/>
            <uie:ColorField name="colorField" class="color-swatch" show-alpha="true" show-eye-dropper="true" />
            <ui:VisualElement class="value-row">
                <ui:FloatField name="rFloat" label="R" class="value-float channel-float" />
                <ui:IntegerField name="rInt" class="value-int" />
            </ui:VisualElement>
            <ui:VisualElement class="value-row">
                <ui:FloatField name="gFloat" label="G" class="value-float channel-float" />
                <ui:IntegerField name="gInt" class="value-int" />
            </ui:VisualElement>
            <ui:VisualElement class="value-row">
                <ui:FloatField name="bFloat" label="B" class="value-float channel-float" />
                <ui:IntegerField name="bInt" class="value-int" />
            </ui:VisualElement>
            <ui:VisualElement class="value-row">
                <ui:FloatField name="aFloat" label="A" class="value-float channel-float" />
                <ui:IntegerField name="aInt" class="value-int" />
            </ui:VisualElement>
            <ui:TextField name="hexField" label="HEX" class="hex-field field-gap" />
        </ui:VisualElement>

        <ui:VisualElement class="mie-block">
            <ui:Label text="HSL + Luma" class="mie-header"/>
            <ui:VisualElement class="value-row">
                <ui:TextField name="hueFloat" label="H" tooltip="0–1" class="value-float channel-float copy-field" />
                <ui:TextField name="hueInt" tooltip="Degrees" class="value-int copy-field" />
            </ui:VisualElement>
            <ui:VisualElement class="value-row">
                <ui:TextField name="saturationFloat" label="S" tooltip="0–1" class="value-float channel-float copy-field" />
                <ui:TextField name="saturationInt" tooltip="Percent" class="value-int copy-field" />
            </ui:VisualElement>
            <ui:VisualElement class="value-row">
                <ui:TextField name="lightnessFloat" label="L" tooltip="0–1" class="value-float channel-float copy-field" />
                <ui:TextField name="lightnessInt" tooltip="Percent" class="value-int copy-field" />
            </ui:VisualElement>
            <ui:TextField name="lumaField" label="Luma" class="hex-field field-gap copy-field" />
        </ui:VisualElement>

        <ui:VisualElement class="mie-block">
            <ui:VisualElement class="header-row">
                <ui:Label text="Code" class="mie-header"/>
                <ui:Button name="copyCodeButton" text="Copy" class="mie-button copy-code-button" tooltip="Copy" />
            </ui:VisualElement>
            <ui:TextField name="codeField" class="code-field copy-field" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
