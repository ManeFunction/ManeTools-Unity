.mie-datetime-field {
    min-width: 0;
}

.mie-datetime-field__input {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
    margin-left: 0;
}

.mie-datetime-field__value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 4px 0 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.mie-datetime-field__button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    height: 18px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--mie-border, #555);
    background-color: var(--mie-button-bg, #333);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.mie-datetime-field__button:hover {
    background-color: var(--mie-button-hover, #444);
}

.mie-datetime-field__button:active {
    background-color: var(--mie-button-active, #555);
}

.mie-datetime-field__button-icon {
    margin: 3px 0 0;
    padding: 0;
    font-size: 13px;
    -unity-text-align: middle-center;
}
