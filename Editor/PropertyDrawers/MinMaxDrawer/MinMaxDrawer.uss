/* Default inspector — ManeStyle overrides margin in ManeEditor.uss */

.mie-fields .mie-minmax-field {
    margin-right: -2px;
}

.mie-minmax-field {
    margin-right: -6px;
}

.mie-minmax-field.unity-composite-field .unity-composite-field__field > .unity-base-field__label {
    flex-basis: auto;
    width: auto;
    min-width: 28px;
    max-width: none;
    flex-shrink: 0;
}
