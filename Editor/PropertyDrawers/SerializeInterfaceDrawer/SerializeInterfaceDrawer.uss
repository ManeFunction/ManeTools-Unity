/* Header is an aligned BaseField. Children sit in a column below it, not inside the field row. */

.mie-serialize-interface {
    flex-grow: 1;
    flex-direction: column;
    flex-shrink: 0;
    min-width: 0;
}

.mie-serialize-interface__field {
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
    align-items: center;
    min-width: 0;
    margin: 1px 0 1px 2px;
    position: relative;
    overflow: visible;
}

.mie-serialize-interface--fields > .mie-serialize-interface__field.unity-base-field {
    flex-grow: 0;
}

.mie-serialize-interface__field > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-self: center;
}

.mie-serialize-interface__arrow {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    min-width: 12px;
    max-width: 12px;
    height: 18px;
    margin: 0;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: transparent;
}

.mie-serialize-interface--fields .mie-serialize-interface__arrow {
    flex-grow: 0;
    width: 12px;
    min-width: 12px;
    max-width: 12px;
}

.mie-serialize-interface__arrow > .unity-base-field__label,
.mie-serialize-interface__arrow > .unity-toggle__text {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0;
    padding: 0;
}

.mie-serialize-interface__arrow > .unity-base-field__input {
    flex-grow: 0;
    margin: 0;
}

/* The title starts 17px in, after the fold arrow. */
.mie-serialize-interface--fields > .mie-serialize-interface--foldout > .unity-base-field__label {
    padding-left: 17px;
}

/* The children's labels follow the title, 2px further in than other child rows. Their inputs stay in the
   column of the other fields: 2px less input margin than ChildFields gives wrapped fields. */
.mie-serialize-interface--fields .mie-child-row {
    padding-left: 15px;
}

.mie-fields .mie-serialize-interface--fields .mie-child-row > .mie-child-content.unity-property-field > .unity-base-field > .unity-base-field__input,
.mie-fields .mie-serialize-interface--fields .mie-child-row > .mie-child-content.unity-property-field > .unity-base-field__input {
    margin-left: 16px;
}

.mie-serialize-interface__type {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 -2px 0 0;
    padding: 0;
}

.mie-serialize-interface__type > .unity-base-field__label {
    display: none;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0;
    padding: 0;
}

.mie-serialize-interface__type > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
}

.mie-serialize-interface__children {
    flex-grow: 0;
    flex-direction: column;
}

.mie-serialize-interface--fields > .mie-serialize-interface__field > .unity-base-field__input {
    margin-left: 13px;
}

.mie-serialize-interface--fields .mie-serialize-interface__arrow > .unity-base-field__label,
.mie-serialize-interface--fields .mie-serialize-interface__arrow > .unity-toggle__text,
.mie-serialize-interface--fields .mie-serialize-interface__type > .unity-base-field__label {
    display: none;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0;
    padding: 0;
}

.mie-serialize-interface--fields .mie-serialize-interface__arrow > .unity-base-field__input {
    margin-left: 0;
    flex-grow: 0;
}

.mie-serialize-interface--fields .mie-serialize-interface__type > .unity-base-field__input {
    margin-left: 0;
}

.mie-serialize-interface--fields .mie-serialize-interface__children .unity-base-field__label,
.mie-serialize-interface--fields .mie-serialize-interface__children .unity-property-field__label {
    flex-basis: var(--mie-nested-label-width);
    width: var(--mie-nested-label-width);
    min-width: var(--mie-nested-label-width);
    max-width: var(--mie-nested-label-width);
}

.mie-fields .unity-list-view .unity-scroll-view .mie-serialize-interface__type,
.mie-fields .unity-collection-view .unity-scroll-view .mie-serialize-interface__type {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mie-fields .unity-list-view__item .mie-serialize-interface__type > .unity-base-field__label,
.mie-fields .unity-collection-view__item .mie-serialize-interface__type > .unity-base-field__label {
    display: none;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0;
    padding: 0;
}

.mie-fields .unity-list-view__item .mie-serialize-interface__type > .unity-base-field__input,
.mie-fields .unity-collection-view__item .mie-serialize-interface__type > .unity-base-field__input {
    margin-left: 0;
    flex-grow: 1;
    min-width: 0;
}

/* Outside ManeStyle the group follows Unity's own nested fields (a PropertyField of a serializable class):
   the arrow hangs left of the label column, the label starts where the other labels do, and the children sit
   15px in with no branch marks. The offsets are measured against that default layout. */

.mie-serialize-interface--default > .mie-serialize-interface__field > .mie-serialize-interface__arrow {
    left: -14px;
}

/* A relative offset moves only the text; a margin would push the input as well. */
.mie-serialize-interface--default > .mie-serialize-interface__field > .unity-base-field__label {
    position: relative;
    left: 1px;
}

.mie-serialize-interface--default > .mie-serialize-interface__children {
    margin-top: 1px;
}

.mie-serialize-interface--default .mie-child-row > .mie-child-branch {
    display: none;
}

.mie-serialize-interface--default .mie-child-row {
    padding-left: 15.5px;
}
