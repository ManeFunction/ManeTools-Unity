/* A child field under a parent field: the field itself, and a branch mark in the 15px slot before it.
   The mark is out of the flow, so the row is exactly as tall as the field. */

.mie-child-row {
    position: relative;
    /* The indent is the row's padding, and every field keeps Unity's own left margin: 3px for a field, and the
       margins of a foldout or of a field Unity draws with IMGUI (a Quaternion, for one), which Unity positions
       from that margin. 13px + 3px puts field labels 16px in, and the others line up with them. */
    padding-left: 13px;
}

.mie-child-row > .mie-child-branch {
    position: absolute;
    left: 1px;
    top: 2px;
    width: 15px;
    height: 18px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* Inputs of wrapped fields sit 6px further right than the standard 12px input margin. */
.mie-fields .mie-child-row > .mie-child-content.unity-property-field > .unity-base-field > .unity-base-field__input,
.mie-fields .mie-child-row > .mie-child-content.unity-property-field > .unity-base-field__input {
    margin-left: 18px;
}
