/* Header toggle — bold section checkbox, not the inspector label column */

.mie-header-toggle {
    margin: 0 0 0 2px;
    padding: 0;
}

.mie-header-toggle .unity-toggle__input {
    margin: 0;
    padding: 0;
}

.mie-header-toggle .unity-toggle__text {
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 5px;
}

.mie-header-toggle.unity-base-field {
    flex-grow: 0;
}

.mie-header-toggle .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0;
    padding: 0;
}

.mie-header-toggle.unity-toggle .unity-base-field__input {
    margin-left: 0;
    flex-grow: 0;
}
