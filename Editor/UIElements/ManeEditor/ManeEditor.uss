/* Shared Mane editor chrome. Root class: mie-root (added by ManeEditorStyles.Apply). */

.mie-root {
    --mie-border: #555;
    --mie-button-bg: #333;
    --mie-button-hover: #444;
    --mie-button-active: #555;
    --mie-label-width: 115px;
    --mie-nested-label-width: 109px;
}

/* Bordered section */
.mie-block {
    border-width: 1px;
    border-color: var(--mie-border);
    padding: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
    padding-bottom: 4px;
    flex-shrink: 0;
}

.mie-block .unity-toggle__text {
    margin-left: 5px;
}

/* 14px bold section title */
.mie-header {
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 2px;
    margin-bottom: 5px;
    flex-shrink: 0;
}

/* Body under a header toggle — no extra horizontal inset, so fields match mie-block */
.mie-content {
    margin-top: 5px;
}

/* Nested bordered group (ease, loops, etc.) */
.mie-nested-block {
    border-width: 1px;
    border-color: var(--mie-border);
    padding: 5px;
    margin-top: 5px;
    margin-bottom: 1px;
}

/* Dark bordered button */
.mie-button {
    border-width: 1px;
    border-color: var(--mie-border);
    background-color: var(--mie-button-bg);
    color: #fff;
}

.mie-button:hover {
    background-color: var(--mie-button-hover);
}

.mie-button:active {
    background-color: var(--mie-button-active);
}

/* Fixed label column — only when Apply() uses FieldLayout */
.mie-fields .unity-base-field {
    flex-grow: 1;
}

.mie-fields .unity-base-field__label,
.mie-fields .unity-property-field__label {
    flex-basis: var(--mie-label-width);
    flex-grow: 0;
    flex-shrink: 0;
    width: var(--mie-label-width);
    min-width: var(--mie-label-width);
    max-width: var(--mie-label-width);
}

.mie-fields .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
    margin-left: 12px;
}

/* Channel chips (X/Y) are labels too — do not give them the inspector column */
.mie-fields .unity-composite-field__field > .unity-base-field__label {
    flex-basis: auto;
    width: auto;
    min-width: 12px;
    max-width: none;
}

.mie-fields .unity-composite-field__field > .unity-base-field__input {
    margin-left: 2px;
}

/* Fill the input zone after Offset — not 100% of the whole row (that overflows) */
.mie-fields .unity-composite-field {
    flex-grow: 1;
    min-width: 0;
}

.mie-fields .unity-composite-field__input,
.mie-fields .unity-composite-field__field-group {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    width: auto;
}

.mie-fields .unity-composite-field__field-spacer {
    display: none;
    flex-grow: 0;
    width: 0;
    min-width: 0;
    max-width: 0;
}

.mie-fields .unity-composite-field__field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 0;
    width: auto;
}

.mie-fields .unity-vector2-field__input #unity-y-input {
    margin-right: 0;
}

.mie-fields .mie-nested-block .unity-base-field__label,
.mie-fields .mie-nested-block .unity-property-field__label {
    flex-basis: var(--mie-nested-label-width);
    width: var(--mie-nested-label-width);
    min-width: var(--mie-nested-label-width);
    max-width: var(--mie-nested-label-width);
}

.mie-fields .unity-event__container {
    margin-top: 5px;
    margin-right: -2px;
}
