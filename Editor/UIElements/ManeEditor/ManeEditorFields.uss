/* Fixed label column + flexing inputs. Loaded only with FieldLayout (ManeStyle / ManeEditor). */

.mie-fields .unity-base-field {
    flex-grow: 1;
}

.mie-fields .unity-base-field__label,
.mie-fields .unity-property-field__label {
    flex-basis: var(--mie-label-width);
    flex-grow: 0;
    flex-shrink: 0;
    width: var(--mie-label-width);
    min-width: var(--mie-label-width);
    max-width: var(--mie-label-width);
}

.mie-fields .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
    margin-left: 12px;
}

/* Channel chips (X/Y) are labels too — do not give them the inspector column */
.mie-fields .unity-composite-field__field > .unity-base-field__label {
    flex-basis: auto;
    width: auto;
    min-width: 12px;
    max-width: none;
}

.mie-fields .unity-composite-field__field > .unity-base-field__input {
    margin-left: 2px;
}

/* Fill the input zone after Offset — not 100% of the whole row (that overflows) */
.mie-fields .unity-composite-field {
    flex-grow: 1;
    min-width: 0;
}

.mie-fields .unity-composite-field__input,
.mie-fields .unity-composite-field__field-group {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    width: auto;
}

.mie-fields .unity-composite-field__field-spacer {
    display: none;
    flex-grow: 0;
    width: 0;
    min-width: 0;
    max-width: 0;
}

.mie-fields .unity-composite-field__field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 0;
    width: auto;
}

.mie-fields .unity-vector2-field__input #unity-y-input {
    margin-right: 0;
}

.mie-fields .mie-nested-block .unity-base-field__label,
.mie-fields .mie-nested-block .unity-property-field__label {
    flex-basis: var(--mie-nested-label-width);
    width: var(--mie-nested-label-width);
    min-width: var(--mie-nested-label-width);
    max-width: var(--mie-nested-label-width);
}

.mie-fields .unity-event__container {
    margin-top: 5px;
    margin-right: -2px;
}

.mie-fields .mie-minmax-field {
    margin-right: -2px;
}

/* Lists — Unity inspector chrome, not the 115px field column */
.mie-fields .unity-list-view,
.mie-fields .unity-collection-view {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
}

.mie-fields .unity-list-view .unity-scroll-view,
.mie-fields .unity-collection-view .unity-scroll-view {
    flex-grow: 0;
    min-height: 0;
}

.mie-fields .unity-list-view__foldout-header > .unity-foldout__toggle {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 22px;
    height: 22px;
    margin: 0;
    padding: 0;
    align-items: center;
}

.mie-fields .unity-list-view__foldout-header > .unity-foldout__toggle > .unity-base-field__input {
    margin-left: 0;
    flex-grow: 0;
}

.mie-fields .unity-list-view__foldout-header > .unity-foldout__toggle > .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
    flex-basis: 0;
    margin: 0;
    padding: 0;
}

.mie-fields .unity-list-view__foldout-header > .unity-foldout__toggle .unity-toggle__text {
    flex-grow: 1;
    flex-basis: auto;
    width: auto;
    min-width: 0;
    max-width: none;
    margin-left: 0;
}

.mie-fields .unity-list-view__foldout-header > .unity-list-view__size-field {
    margin-right: 4px;
}

.mie-fields .unity-list-view__foldout-header > .unity-foldout__content {
    margin-left: 0;
    padding-left: 0;
}

.mie-fields .unity-list-view__size-field > .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
    flex-basis: 0;
    margin: 0;
    padding: 0;
}

.mie-fields .unity-list-view__size-field {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 40px;
    max-width: 50px;
    height: 18px;
    min-height: 18px;
}

.mie-fields .unity-list-view__size-field > .unity-base-field__input {
    margin-left: 0;
    min-width: 0;
}

.mie-fields .unity-list-view .unity-scroll-view .unity-base-field,
.mie-fields .unity-collection-view .unity-scroll-view .unity-base-field {
    flex-grow: 0;
    align-self: stretch;
}

.mie-fields .unity-list-view__item .unity-base-field__label,
.mie-fields .unity-list-view__item .unity-property-field__label,
.mie-fields .unity-collection-view__item .unity-base-field__label,
.mie-fields .unity-collection-view__item .unity-property-field__label {
    flex-basis: var(--mie-nested-label-width);
    width: var(--mie-nested-label-width);
    min-width: var(--mie-nested-label-width);
    max-width: var(--mie-nested-label-width);
}

.mie-fields .unity-list-view__footer {
    flex-grow: 0;
}

.mie-fields .unity-list-view__reorderable-item__container {
    margin: 0 0 0 -10px;
}
